<?xml version="1.0" encoding="utf-8"?>
<!--
  The catalogue stub, as an IIS application at alias "api/catalog" with the bundle's "tools"
  folder as its physical path. Copied there as web.config by package-storefront.

  HttpPlatformHandler forwards the original path, so the stub still sees /api/catalog/products
  and needs no rewriting. It reads data/catalog.json beside it — the 70 products.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="node.exe"
                  arguments="scripts/stub-api.mjs"
                  stdoutLogEnabled="true"
                  stdoutLogFile="./logs/stub"
                  startupTimeLimit="60">
      <environmentVariables>
        <environmentVariable name="STUB_API_PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
