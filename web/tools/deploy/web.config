<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site root for the UP Bazaar storefront.

  Needs the HttpPlatformHandler module on the server (a small MSI from Microsoft). IIS then
  starts server/server.mjs itself, hands it a private port and forwards every request to it —
  no Windows service to register, no ARR, and it restarts the process if it dies.

  Point an IIS site at the folder containing this file, then add a second application under it
  at alias "api/catalog" whose physical path is the "tools" folder beside this one.

  Forward slashes on purpose: node accepts them on Windows, and they survive being read back out
  of an XML attribute without anyone having to think about escaping.
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Everything, static files included: Node serves them and sets the cache headers. -->
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="node.exe"
                  arguments="server/server.mjs"
                  stdoutLogEnabled="true"
                  stdoutLogFile="./logs/storefront"
                  startupTimeLimit="120"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <!-- IIS picks the port and the server reads PORT. Leave this alone. -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />

        <!--
          CHANGE THIS. Angular refuses any request whose Host header is not listed, so the
          example below makes the site answer 400 to every real visitor. Put your own hostnames
          in, comma separated. Do not use "*" unless something in front is already validating
          the header.
        -->
        <environmentVariable name="NG_ALLOWED_HOSTS" value="upbazaar.example,www.upbazaar.example" />

        <!--
          Where the server render fetches the catalogue. It goes back through IIS, which routes
          /api/catalog to the stub application. If the site is not bound to port 80 on localhost,
          put the right origin here instead.
        -->
        <environmentVariable name="SSR_API_ORIGIN" value="http://localhost" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
