<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site root for UP Bazaar: the storefront at /, the seller portal at /seller/ and the admin
  portal at /admin/, on one website and one domain.

  Nothing runs here. The catalogue is prerendered into real HTML files at build time, so IIS
  serves this site the way it serves any folder of static files: no HttpPlatformHandler, no Node
  process, no application pool doing anything unusual.

  The one thing it does besides serve files is forward /api to the .NET API, which the browser
  calls on this origin for live prices, stock, sign-in and accounts. That forwarding needs URL
  Rewrite and Application Request Routing (ARR), with the proxy switched on at server level.
  Change API_UPSTREAM below if the API is not on this machine at port 5199.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>

        <!--
          API_UPSTREAM. Everything under /api goes to the .NET API, path and query unchanged, so
          the browser only ever talks to one origin and the bearer token never crosses to
          another. First, so no static-file rule can claim an /api URL.
        -->
        <rule name="API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:5199/api/{R:1}" />
        </rule>

        <!--
          The portals. The seller portal lives in the seller folder and the admin portal in
          admin, each an application of its own with its page's base set to that folder. These
          two rules come before the storefront's, which would otherwise answer /seller/orders
          with the storefront's shell.

          Without its trailing slash a portal's address would still load, but a relative link
          in the page would be worked out against the wrong folder; send it to the right one.
        -->
        <rule name="Portal folder" stopProcessing="true">
          <match url="^(seller|admin)$" />
          <action type="Redirect" url="/{R:1}/" redirectType="Permanent" />
        </rule>

        <!--
          A portal draws every one of its pages in the browser, so any address under its folder
          that is not a real file gets that portal's own page, and its router takes it from
          there. As for the storefront below, something that looks like an asset is left to
          answer 404 rather than HTML.
        -->
        <rule name="Portal pages" stopProcessing="true">
          <match url="^(seller|admin)/.+" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}"
                 pattern="\.(js|mjs|css|map|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|eot|json|txt|xml|webmanifest)$"
                 negate="true" />
          </conditions>
          <action type="Rewrite" url="/{R:1}/index.html" />
        </rule>

        <!--
          The application's own root route redirects to /products, and the prerenderer rendered
          that as an index.html holding a meta refresh. A real 301 is faster, survives with
          JavaScript disabled, and is the answer a crawler is looking for, so do it here and let
          that file go unused.
        -->
        <rule name="Root to catalogue" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/products" redirectType="Permanent" />
        </rule>

        <!--
          A prerendered page. /products/<id> is a directory holding index.html, and IIS would
          answer the URL without its trailing slash by redirecting to add one. That redirect is
          visible to crawlers and doubles the request, so serve the file directly instead.
        -->
        <rule name="Prerendered page" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{DOCUMENT_ROOT}/{R:1}/index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}/index.html" />
        </rule>

        <!--
          Everything else the router owns — /sign-in, /account, /cart — has no prerendered file
          because those pages are client-rendered by design. Hand them the shell and let Angular
          route on the client, which is what makes a refresh or a shared link work.

          The shell is index.csr.html, not index.html. index.html is the prerendered root route,
          which is a meta refresh to /products: falling back to it would bounce every refresh on
          /sign-in over to the catalogue. index.csr.html is the empty shell that boots the router
          against whatever URL the browser actually asked for, which is the one we want.

          Requests that look like an asset are deliberately excluded. Without that, a missing
          .js or .css file answers 200 with HTML, the browser fails to parse it, and the real
          fault — a file that did not deploy — is buried under a confusing syntax error.
        -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}"
                 pattern="\.(js|mjs|css|map|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|eot|json|txt|xml|webmanifest)$"
                 negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.csr.html" />
        </rule>

      </rules>
    </rewrite>

    <!--
      An hour is short enough that a redeploy reaches people the same day and long enough to be
      worth having. The asset filenames carry a content hash, so they could be cached far longer;
      index.html cannot, and both sit in this same folder, which is why one modest value covers
      them. Cloudflare in front applies its own rules by file type on top of this.
    -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
