<?xml version="1.0" encoding="utf-8"?>
<!--
  The catalogue, as an IIS application at api/catalog.

  The folders are laid out to match the URL on purpose. IIS Manager only accepts one path segment
  as an application alias, so "api/catalog" is rejected outright — but with the stub sitting in
  api\catalog, adding it is a right-click on that folder, "Convert to Application", and the alias
  is simply "catalog". The application lands at /api/catalog with nothing further to configure.

  HttpPlatformHandler forwards the original path, so the stub still sees /api/catalog/products
  and needs no rewriting. It reads ..\..\tools\data\catalog.json — the 70 products.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="node.exe"
                  arguments="stub-api.mjs"
                  stdoutLogEnabled="true"
                  stdoutLogFile="./logs/catalog"
                  startupTimeLimit="60">
      <environmentVariables>
        <!-- IIS picks the port; the stub reads STUB_API_PORT. Leave this alone. -->
        <environmentVariable name="STUB_API_PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
