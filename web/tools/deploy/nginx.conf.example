# One public origin for the whole site: the storefront at /, the seller portal at /seller/ and the
# admin portal at /admin/. Copy into sites-available and adjust server_name, the root path and the
# certificate paths.
#
# The site is static: nginx serves files off disk. The only thing proxied is /api, which the
# browser calls for live prices, stock and sign-in.

server {
  listen 80;
  server_name market.pashudhanup.com;

  root /var/www/upbazaar;
  index index.html;

  # The .NET API. Required: the prerendered product pages refetch live prices and stock from it
  # as they load, and empty without it. The API needs SQL Server to start at all.
  location /api/ {
    proxy_pass http://127.0.0.1:5199;
    proxy_set_header Host $host;
    # The API caps sign-in attempts per client address; without these it would see only nginx.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # The portals, each an application of its own in its folder. Any address under the folder that
  # is not a real file gets that portal's page, and its router takes it from there.
  location = /seller { return 301 /seller/; }
  location = /admin  { return 301 /admin/; }

  location /seller/ {
    try_files $uri /seller/index.html;
  }

  location /admin/ {
    try_files $uri /admin/index.html;
  }

  # Three attempts, in order:
  #   the file itself          - assets, and anything else that really is on disk
  #   $uri/index.html          - a prerendered page, e.g. /products/<id>
  #   /index.html              - a client-rendered route, e.g. /sign-in, /account
  #
  # The last one is what makes a refresh or a shared link work on pages that have no file.
  location / {
    try_files $uri $uri/index.html /index.html;
  }

  # An asset that failed to deploy should say so rather than being handed the shell, which the
  # browser then fails to parse and reports as a syntax error somewhere unrelated.
  location ~* \.(js|mjs|css|map|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|eot|json|txt|xml|webmanifest)$ {
    try_files $uri =404;
    expires 1h;
  }
}
