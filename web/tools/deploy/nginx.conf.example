# One public origin in front of the storefront. Copy into sites-available and adjust
# server_name, the root path and the certificate paths.
#
# The site is static: nginx serves files off disk and nothing is proxied. The only routing that
# matters is the fallback order in try_files.

server {
  listen 80;
  server_name market.pashudhanup.com;

  root /var/www/upbazaar;
  index index.html;

  # The .NET API, for sign-in. Optional: leave it out and the storefront still works, it just
  # cannot sign anyone in. The API needs SQL Server to start at all.
  #
  # location /api/ {
  #   proxy_pass http://127.0.0.1:5199;
  #   proxy_set_header Host $host;
  # }

  # Three attempts, in order:
  #   the file itself          - assets, and anything else that really is on disk
  #   $uri/index.html          - a prerendered page, e.g. /products/<id>
  #   /index.html              - a client-rendered route, e.g. /sign-in, /account
  #
  # The last one is what makes a refresh or a shared link work on pages that have no file.
  location / {
    try_files $uri $uri/index.html /index.html;
  }

  # An asset that failed to deploy should say so rather than being handed the shell, which the
  # browser then fails to parse and reports as a syntax error somewhere unrelated.
  location ~* \.(js|mjs|css|map|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|eot|json|txt|xml|webmanifest)$ {
    try_files $uri =404;
    expires 1h;
  }
}
