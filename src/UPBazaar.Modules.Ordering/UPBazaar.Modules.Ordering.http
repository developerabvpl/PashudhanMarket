@host = https://localhost:7001
@token = {{$dotenv UPBAZAAR_TOKEN}}
@orderId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000

### Check out a cart
POST {{host}}/api/ordering/orders/checkout
Authorization: Bearer {{token}}
Idempotency-Key: 5a7f2c1e-checkout-001
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "sellerId": "11111111-1111-1111-1111-111111111111",
  "deliveryPostcode": "221001",
  "lines": [
    { "productId": "{{productId}}", "quantity": 2 }
  ]
}

### Retry the same checkout - must replay the first order, not place a second
POST {{host}}/api/ordering/orders/checkout
Authorization: Bearer {{token}}
Idempotency-Key: 5a7f2c1e-checkout-001
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "sellerId": "11111111-1111-1111-1111-111111111111",
  "deliveryPostcode": "221001",
  "lines": [
    { "productId": "{{productId}}", "quantity": 2 }
  ]
}

### Get the order
GET {{host}}/api/ordering/orders/{{orderId}}
Authorization: Bearer {{token}}

### Cancel an unpaid order
POST {{host}}/api/ordering/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Customer changed their mind"
}
