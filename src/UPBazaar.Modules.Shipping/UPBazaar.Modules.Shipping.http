@host = https://localhost:7001
@token = {{$dotenv UPBAZAAR_TOKEN}}
@shipmentId = 00000000-0000-0000-0000-000000000000
@orderId = 00000000-0000-0000-0000-000000000000

### Get a shipment
GET {{host}}/api/shipping/shipments/{{shipmentId}}
Authorization: Bearer {{token}}

### Get the shipment booked for an order
# Shipments are created by the outbox handler reacting to OrderPlaced, not by a POST.
GET {{host}}/api/shipping/shipments/by-order/{{orderId}}
Authorization: Bearer {{token}}
