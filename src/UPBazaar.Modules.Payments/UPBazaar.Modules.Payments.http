@host = https://localhost:7001
@token = {{$dotenv UPBAZAAR_TOKEN}}
@paymentId = 00000000-0000-0000-0000-000000000000
@gatewayOrderId = order_0000000000000

### Get a payment
GET {{host}}/api/payments/{{paymentId}}
Authorization: Bearer {{token}}

### Refund part of a captured payment
POST {{host}}/api/payments/{{paymentId}}/refunds
Authorization: Bearer {{token}}
Idempotency-Key: refund-001
Content-Type: application/json

{
  "amount": 500.00,
  "reason": "Damaged in transit"
}

### Retry the same refund - must replay, not refund twice
POST {{host}}/api/payments/{{paymentId}}/refunds
Authorization: Bearer {{token}}
Idempotency-Key: refund-001
Content-Type: application/json

{
  "amount": 500.00,
  "reason": "Damaged in transit"
}

### Gateway webhook - payment captured
# The signature is HMAC-SHA256 of the raw body using ExternalServices:Razorpay:WebhookSecret.
# In sandbox, FakePaymentGateway.SignForTest produces it.
POST {{host}}/api/payments/webhooks/razorpay
X-Razorpay-Event-Id: evt_capture_001
X-Razorpay-Signature: replace-with-hmac-of-body
Content-Type: application/json

{
  "event": "payment.captured",
  "payload": {
    "payment": {
      "entity": {
        "id": "pay_test_0001",
        "order_id": "{{gatewayOrderId}}",
        "amount": 464900
      }
    }
  }
}

### Gateway webhook - payment failed
POST {{host}}/api/payments/webhooks/razorpay
X-Razorpay-Event-Id: evt_fail_001
X-Razorpay-Signature: replace-with-hmac-of-body
Content-Type: application/json

{
  "event": "payment.failed",
  "payload": {
    "payment": {
      "entity": {
        "id": "pay_test_0002",
        "order_id": "{{gatewayOrderId}}",
        "error_description": "Card declined by issuer"
      }
    }
  }
}
