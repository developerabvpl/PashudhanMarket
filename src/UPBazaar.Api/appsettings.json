{
  "ConnectionStrings": {
    "UPBazaar": ""
  },
  "Jwt": {
    "Issuer": "https://upbazaar.dev",
    "Audience": "upbazaar-api"
  },
  "Hangfire": {
    "Enabled": true,
    "EnableServer": true
  },
  "ExternalServices": {
    "UseSandbox": true,
    "Razorpay": {
      "BaseUrl": "https://api.razorpay.com/v1/"
    },
    "Shiprocket": {
      "BaseUrl": "https://apiv2.shiprocket.in/v1/external/"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
